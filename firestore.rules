rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function perfil() { return request.auth.token.perfil; }
    function ehStaff() { return perfil() == 'COORDENADOR' || perfil() == 'ADMIN'; }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehStaff());
      allow write: if ehStaff();
    }

    match /tccs/{id} {
      allow read: if logado() && (
        resource.data.orientador_id == request.auth.uid ||
        resource.data.aluno_id == request.auth.token.matricula ||
        ehStaff());
      allow write: if ehStaff();
    }

    match /feedbacks/{id} {
      allow read: if logado();
      allow create: if perfil() == 'ORIENTADOR';
      allow update, delete: if false;   // imutável (RN02, US04-AC2)
    }

    match /cronogramas/{id} { allow read: if logado(); allow write: if ehStaff(); }
    match /marcos_cronograma/{id} { allow read: if logado(); allow write: if ehStaff(); }

    // Demais coleções: bloqueadas até as regras ficarem prontas
    match /{document=**} { allow read, write: if false; }
  }
}