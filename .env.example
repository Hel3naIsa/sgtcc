# ==============================================================================
# SGTCC - Variáveis de Ambiente do Firebase
# ==============================================================================

# Firebase Client SDK (Públicas - utilizadas pelo Frontend / Browser)
NEXT_PUBLIC_FIREBASE_API_KEY=sua-api-key-aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sgtcc-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sgtcc-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sgtcc-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef0123456789
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABCDEF0123

# Firebase Admin SDK (Privadas - utilizadas apenas no Servidor / API Routes / Seed)
FIREBASE_PROJECT_ID=sgtcc-projeto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sgtcc-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_A_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# Senha das personas de teste.
SEED_PASSWORD=defina-uma-senha-de-teste-aqui
